{
  "name": "dsh-pcb-eda",
  "private": true,
  "version": "0.7.15",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "pack:check": "pnpm -r pack --dry-run",
    "bump": "node scripts/bump.mjs",
    "check:publish": "node scripts/check-publish.mjs",
    "check:publish:release": "node scripts/check-publish.mjs --require-clean",
    "check:release:version": "node scripts/check-release-version.mjs",
    "publish:dry": "node scripts/publish.mjs --dry-run",
    "publish:local": "node scripts/publish.mjs",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs",
    "manifest:prepare": "node scripts/release-manifest.mjs",
    "manifest:publish": "node scripts/release-manifest.mjs --publish",
    "launch-dsh": "node scripts/launch-dsh.mjs",
    "launch-dsh:standalone": "node scripts/launch-dsh-standalone.mjs",
    "link-plugins:kicad": "node scripts/link-plugins-kicad.mjs",
    "unlink-plugins:kicad": "node scripts/link-plugins-kicad.mjs --unlink",
    "plugin-status:kicad": "node scripts/link-plugins-kicad.mjs --status"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^26.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "tsx": "^4.21.0",
    "@types/react": "^18.3.31"
  }
}
