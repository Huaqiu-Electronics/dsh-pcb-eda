node_modules/
dist/
lib/
# scripts/lib is checked-in source (shared package discovery), not build output
!scripts/lib/
coverage/
*.tgz
.DS_Store
*.log
# scratch DSH_HOME used by the stock-DSH smoke test (docs/tasks/start-p0.md)
.smoke/
!packages/dsh-hqsch/skills/hqsch-scenario-b/template/scripts/lib
# FreeRouting runtime dependencies are prepared from locks, not committed.
packages/dsh-tool-freerouting/python/**/__pycache__/
packages/dsh-tool-freerouting/python/**/*.pyc
# KiCad per-user local state: lock files (~<board>.lck) and view/layer settings
# (*.prl). Opening a board in KiCad creates these next to it; they are never
# shared and, inside test/fixtures, they get picked up by the readdirSync loop in
# adapter.test.ts and fed to the S-expression parser, which fails on them.
*.prl
*.kicad_prl
~*.lck
# Edge/Electron webview cache written next to the boards the pcb-viewer opens.
packages/dsh-tool-pcb-viewer/test/fixtures/.hq/
# Agent session memory/logs; project notes live outside the repo.
.workbuddy/
# release-pcblint.ps1 build artifacts (zip + sha256 + manifest for CDN upload)
packages/dsh-kicad-drc/scripts/release/
