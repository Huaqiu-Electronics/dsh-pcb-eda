{
  "name": "@huaqiu/dsh-artifacts",
  "version": "0.4.1",
  "type": "module",
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./placement": {
      "types": "./lib/placement.d.mts",
      "default": "./lib/placement.mjs"
    },
    "./service": {
      "types": "./lib/service.d.mts",
      "default": "./lib/service.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.0",
    "@huaqiu/dsh-plugin-log": "workspace:*"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  }
}
