{
  "name": "@huaqiu/dsh-hardware-ui",
  "version": "0.7.18",
  "type": "module",
  "description": "Hardware Engineering product UI for DSH: five-destination engineering navigation, right-panel artifact viewer, CAD installation settings and contextual native-application actions.",
  "license": "MIT",
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "engines": {
    "dsh": "^0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@huaqiu/ecad-renderer": "0.2.6",
    "@huaqiu/kicad-sexpr-parser": "0.1.3",
    "@types/react": "~18.3.1",
    "@types/three": "^0.185.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "occt-import-js": "0.0.23"
  }
}
